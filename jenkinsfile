pipeline {
    agent any
    environment {
            DOCKER_HUB_REPO = 'test/test-app'
    }
    stages {
        stage( 'Build Docker Image' ){
            steps {
                script {
                        echo 'building docker image..'
                        docker.build ("${DOCKER_HUB_REPO}:latest")
                }
            }
        }
        stage('Build') {
            steps {
                echo 'Building...'
            }
        }
        stage('Test') {
            steps {
                echo 'Testing...'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying...'
            }
        }
    }
}
